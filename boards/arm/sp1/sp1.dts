/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>

/ {
	model = "Teenage Engineering SP-1 Stem Player";
	compatible = "teeneng,sp-1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &app_partition;
	};

	aliases {
		watchdog0 = &wdt0;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bootloader_partition: partition@0 {
			label = "sp1-bootloader";
			reg = <0x00000000 0x00020000>;
		};

		app_partition: partition@20000 {
			label = "sp1-app";
			reg = <0x00020000 0x000BF000>;
		};
	};
};

&nfct {
	status = "disabled";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpiote {
	status = "okay";
};
