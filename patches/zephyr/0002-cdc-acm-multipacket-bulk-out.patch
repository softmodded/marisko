@@ -156,10 +156,15 @@ static struct net_buf *cdc_acm_buf_alloc(struct usbd_class_data *const c_data,
  * The required buffer is 128 bytes per instance on a full-speed device. Use
  * common (UDC) buffer, as this results in a smaller footprint.
  */
+/* SP-1: allocate larger bulk buffers so OUT transfers can span many FS packets
+ * (the nRF EasyDMA fills the whole buffer before completing) → far fewer
+ * per-packet turnarounds → much higher upload throughput. 512 = 8 × 64-byte FS
+ * packets; must be ≤ the UDC pool buffer size (CONFIG_UDC_BUF_POOL_SIZE/COUNT). */
+#define SP1_BULK_BUF_SZ 512U
 static struct net_buf *cdc_acm_buf_alloc(struct usbd_class_data *const c_data,
 					 const uint8_t ep)
 {
-	return usbd_ep_buf_alloc(c_data, ep, USBD_MAX_BULK_MPS);
+	return usbd_ep_buf_alloc(c_data, ep, SP1_BULK_BUF_SZ);
 }
 #endif /* CONFIG_USBD_CDC_ACM_BUF_POOL */
 
@@ -712,8 +717,20 @@ static void cdc_acm_rx_fifo_handler(struct k_work *work)
 		return;
 	}
 
-	/* Shrink the buffer size if operating on a full speed bus */
-	buf->size = MIN(cdc_acm_get_bulk_mps(c_data), buf->size);
+	/* SP-1: enqueue a multi-packet OUT transfer — as much of the buffer as the
+	 * rx_fifo can absorb, rounded down to whole MPS packets. The host streams
+	 * back-to-back 64-byte packets into one DMA transfer instead of one packet
+	 * per turnaround. (Stock code shrank this to a single MPS on FS.) */
+	{
+		size_t mps = cdc_acm_get_bulk_mps(c_data);
+		size_t space = ring_buf_space_get(data->rx_fifo.rb);
+		size_t cap = MIN((size_t)buf->size, space);
+		cap = (cap / mps) * mps;
+		if (cap < mps) {
+			cap = mps;
+		}
+		buf->size = cap;
+	}
 
 	ret = usbd_ep_enqueue(c_data, buf);
 	if (ret) {
