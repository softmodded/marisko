using "platforms/cpus/nrf52840.repl"

sp1_playback_leds: GPIOPort.LEDs @ gpioPortB 0x50000000
    0 -> led_playback_2@0 { gpio: gpio0 }
    1 -> led_playback_4@1 { gpio: gpio0 }
    12 -> led_playback_3@12 { gpio: gpio1 }
    13 -> led_playback_1@13 { gpio: gpio1 }

sp1_track_leds: GPIOPort.LEDs @ gpioPortC 0x50000000
    29 -> led_track_1@29 { gpio: gpio0 }
    26 -> led_track_2@26 { gpio: gpio0 }
    15 -> led_track_3@15 { gpio: gpio1 }
    14 -> led_track_4@14 { gpio: gpio1 }

sp1_fn_button: GPIOPort.Buttons @ gpioPortD 0x50000000
    27 -> btn_function@27 { gpio: gpio0 }

i2c0: I2C.NRF52840 @ sysbus 0x40003000
    0x18: I2C.StubPeripheral @ sysbus 0x40003000
    0x48: I2C.StubPeripheral @ sysbus 0x40003000

sp1_eMMC: Memory.MappedMemory @ sysbus 0xA0000000
    size: 0x100000000
