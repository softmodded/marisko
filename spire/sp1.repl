using "platforms/cpus/nrf52840.repl"

# Playback LEDs (between PLAY and FUNCTION buttons)
# P1.13, P0.00, P1.12, P0.01 — active HIGH

gpio1:
    13 -> led_pb1@0
    12 -> led_pb3@0

gpio0:
    0 -> led_pb2@0
    1 -> led_pb4@0

led_pb1: Miscellaneous.LED @ gpio1 13
led_pb2: Miscellaneous.LED @ gpio0 0
led_pb3: Miscellaneous.LED @ gpio1 12
led_pb4: Miscellaneous.LED @ gpio0 1

# Track LEDs (above the 4 track buttons)
# P0.29, P0.26, P1.15, P1.14 — active HIGH

gpio1:
    15 -> led_t3@0
    14 -> led_t4@0

gpio0:
    29 -> led_t1@0
    26 -> led_t2@0

led_t1: Miscellaneous.LED @ gpio0 29
led_t2: Miscellaneous.LED @ gpio0 26
led_t3: Miscellaneous.LED @ gpio1 15
led_t4: Miscellaneous.LED @ gpio1 14

# Function button (P0.27) — active LOW with pull-up
btn_function: Miscellaneous.Button @ gpio0 27
    invert: true
    -> gpio0@27
